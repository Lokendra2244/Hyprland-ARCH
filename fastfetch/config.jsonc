// execute with: fastfetch --colors-block-range-start 9 --colors-block-width 3

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",  // Automatically detects the best protocol (kitty, sixel, chafa, etc.)
        "source": "~/.config/fastfetch/ascii/courage_dog2.png",
        "width": 27,     // Adjust width (in characters)
        "height": 13,    // Adjust height (in lines)
        "padding": {
            "top": 1,
            "right": 4
       }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
        },
        {
            "type": "kernel",
            "key": " ",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
        },
        {
            "type": "shell",
            "key": " ",
        },
        {
            "type": "terminal",
            "key": " ",
        },
        {
            "type": "wm",
            "key": " ",
        },
        {
            "type": "uptime",
            "key": " ",
        },
        {
            "type": "media",
            "key": "󰝚 ",
        },
        "break",
        "colors",
        "break",
        "break",
    ]
}
