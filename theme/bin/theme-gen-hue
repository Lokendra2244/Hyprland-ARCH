#!/usr/bin/env python3
"""theme-gen-hue <name> <hue 0-360>  — write schemes/<name>.toml: a dark theme tinted toward one hue.
Every generated theme shares the same ANSI hues and lightness, so they stay compatible with each other."""
import colorsys, os, pathlib, sys

if len(sys.argv) < 3:
    sys.exit(__doc__)
name, hue = sys.argv[1], float(sys.argv[2])
out = pathlib.Path(os.environ.get("THEME_DIR", pathlib.Path.home() / ".config/theme")) / "schemes"


def hx(h, s, l):
    r, g, b = colorsys.hls_to_rgb((h % 360) / 360, l, s)
    return f"{round(r * 255):02x}{round(g * 255):02x}{round(b * 255):02x}"


neutral = [(.28, .075), (.26, .105), (.22, .150), (.14, .300), (.12, .520), (.20, .840), (.25, .900), (.30, .950)]
ansi = {"base08": 355, "base09": 24, "base0A": 46, "base0B": 128, "base0C": 176, "base0D": 212, "base0E": 268, "base0F": 330}
lines = [f'name = "{name.replace("-", " ").title()}"',
         f'accent = "#{hx(hue, .70, .62)}"', f'accent2 = "#{hx(hue + 35, .62, .66)}"',
         f'accent3 = "#{hx(hue - 35, .62, .66)}"', "", "[palette]"]
for i, (s, l) in enumerate(neutral):
    lines.append(f'base0{i} = "{hx(hue, s, l)}"')
for slot, h in ansi.items():
    lines.append(f'{slot} = "{hx(h, .62, .68)}"')
(out / f"{name}.toml").write_text("\n".join(lines) + "\n")
print(f"wrote {out / (name + '.toml')}")
