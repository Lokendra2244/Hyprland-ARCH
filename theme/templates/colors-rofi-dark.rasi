/* generated by theme-render — {{name}} */
* {
    background:  {{background}};
    foreground:  {{foreground}};
    accent:      {{accent}};

    active-background:   {{accent2}};
    active-foreground:   @foreground;
    normal-background:   @background;
    normal-foreground:   @foreground;
    urgent-background:   {{color1}};
    urgent-foreground:   @foreground;

    alternate-active-background:   @background;
    alternate-active-foreground:   @foreground;
    alternate-normal-background:   @background;
    alternate-normal-foreground:   @foreground;
    alternate-urgent-background:   @background;
    alternate-urgent-foreground:   @foreground;

    selected-active-background:   {{accent2}};
    selected-active-foreground:   {{on_accent}};
    selected-normal-background:   {{accent}};
    selected-normal-foreground:   {{on_accent}};
    selected-urgent-background:   {{color1}};
    selected-urgent-foreground:   {{on_accent}};

    background-color: @background;
    border-color:     @accent;
    spacing: 2;
}
