
// 1. Input Configuration
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 600
        repeat-rate 25
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        accel-profile "flat"
    }
}

// 2. Output Configuration (Adjust scale/mode as needed)
output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1.0
}

// 3. Layout & Styling (PYWAL INTEGRATION)
// We removed the hardcoded layout block to use the Pywal cache
include "/home/lokendra/.cache/wal/colors-niri.kdl"

// Fallback layout settings (in case Pywal fails)
// These are usually overridden by the include above
layout {
    gaps 16
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    
    // Border/Focus fallback if pywal is missing
    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}


// 4. Startup Applications
// Using the split config file we created
spawn-at-startup "waybar" "-c" "~/.config/waybar/config-niri.jsonc"
spawn-at-startup "xwayland-satellite" // If you use XWayland apps
spawn-at-startup "swww-daemon" // Wallpaper daemon

// 5. Window Rules
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Transparent apps (Ghostty handles its own opacity, but strictly enforcing here helps)
window-rule {
    match app-id="com.mitchellh.ghostty"
    opacity 1.0
}

// 6. Keybindings
binds {
    // --- Application Launchers ---
    // Terminal (Ghostty)
    Mod+Q { spawn "ghostty"; }
    
    // File Manager (Yazi via Ghostty) - As discussed
    Mod+E { spawn "ghostty" "-e" "yazi"; }
    
    // Application Launcher (Fuzzel/Rofi/Wofi)
    Mod+D { spawn "fuzzel"; } 

    // Waybar Toggle (Using the script we fixed)
    Mod+B { spawn "zen-browser"; }

    // --- Window Management ---
    Mod+C { close-window; }
    Mod+Shift+E { quit; }

    // Focus Movement
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }

    // Window Movement
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }

    // Column resizing
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Audio Controls
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    
    // Brightness
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
    
    // Screenshots
    Print { spawn "grimshot" "save" "active"; }
}
